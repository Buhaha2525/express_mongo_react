pipeline {
    agent any

    environment {
        //AWS_REGION = 'us-west-2'
        PROJECT_NAME = 'fullstack-app'
        ENVIRONMENT = 'dev'
        DOCKER_REGISTRY = 'your-registry.com'
        KUBERNETES_NAMESPACE = 'fullstack-app'
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['build-scan', 'build-deploy', 'deploy-only', 'security-scan'],
            description: 'Action à exécuter'
        )
        choice(
            name: 'DEPLOY_TYPE',
            choices: ['basic', 'with-db', 'full'],
            description: 'Type de déploiement'
        )
        booleanParam(
            name: 'FAIL_ON_VULNERABILITIES',
            defaultValue: true,
            description: 'Échouer le build si vulnérabilités critiques'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'Tag pour les images Docker'
        )
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    stages {
        stage('🚀 DÉMARRAGE RAPIDE') {
            steps {
                checkout scm
                script {
                    currentBuild.displayName = "#${currentBuild.number} - ${params.ACTION}"
                    currentBuild.description = "Image: ${params.IMAGE_TAG} - Type: ${params.DEPLOY_TYPE}"
                    echo "🔧 SCAN DE SÉCURITÉ AVEC TRIVY"
                    echo "📦 Action: ${params.ACTION}"
                    echo "🎯 Type: ${params.DEPLOY_TYPE}"
                    echo "🐳 Image Tag: ${params.IMAGE_TAG}"
                }
            }
        }

        stage('🔍 VÉRIFICATION DU CODE') {
            steps {
                script {
                    echo "🔍 Analyse de la structure du projet..."

                    // Vérification de la présence des Dockerfiles
                    def hasBackendDockerfile = fileExists('backend/Dockerfile')
                    def hasFrontendDockerfile = fileExists('frontend/Dockerfile')
                    def hasKubernetesManifests = fileExists('kubernetes/')

                    echo "🐳 Backend Dockerfile: ${hasBackendDockerfile}"
                    echo "🐳 Frontend Dockerfile: ${hasFrontendDockerfile}"
                    echo "☸️  Kubernetes Manifests: ${hasKubernetesManifests}"

                    env.HAS_DOCKER_IMAGES = hasBackendDockerfile || hasFrontendDockerfile
                    env.HAS_KUBERNETES = hasKubernetesManifests
                }
            }
        }

        stage('🐳 1. BUILD DES IMAGES DOCKER') {
            when {
                expression {
                    params.ACTION in ['build-scan', 'build-deploy'] &&
                    env.HAS_DOCKER_IMAGES == 'true'
                }
            }
            parallel {
                stage('🔧 Build Backend') {
                    when {
                        expression { fileExists('backend/Dockerfile') }
                    }
                    steps {
                        script {
                            echo "🔧 Construction de l'image Backend..."

                            dir('backend') {
                                // Build de l'image Docker
                                sh """
                                docker build -t ${env.DOCKER_REGISTRY}/${PROJECT_NAME}-backend:${params.IMAGE_TAG} .
                                docker tag ${env.DOCKER_REGISTRY}/${PROJECT_NAME}-backend:${params.IMAGE_TAG} ${env.DOCKER_REGISTRY}/${PROJECT_NAME}-backend:latest
                                """

                                // Sauvegarde de l'image pour Trivy
                                sh """
                                docker save -o backend-image.tar ${env.DOCKER_REGISTRY}/${PROJECT_NAME}-backend:${params.IMAGE_TAG}
                                """
                            }
                        }
                    }
                }

                stage('🌐 Build Frontend') {
                    when {
                        expression { fileExists('frontend/Dockerfile') }
                    }
                    steps {
                        script {
                            echo "🌐 Construction de l'image Frontend..."

                            dir('frontend') {
                                // Build de l'image Docker
                                sh """
                                docker build -t ${env.DOCKER_REGISTRY}/${PROJECT_NAME}-frontend:${params.IMAGE_TAG} .
                                docker tag ${env.DOCKER_REGISTRY}/${PROJECT_NAME}-frontend:${params.IMAGE_TAG} ${env.DOCKER_REGISTRY}/${PROJECT_NAME}-frontend:latest
                                """

                                // Sauvegarde de l'image pour Trivy
                                sh """
                                docker save -o frontend-image.tar ${env.DOCKER_REGISTRY}/${PROJECT_NAME}-frontend:${params.IMAGE_TAG}
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('🔒 2. SCAN DE SÉCURITÉ TRIVY') {
            when {
                expression {
                    params.ACTION in ['build-scan', 'security-scan', 'build-deploy'] &&
                    env.HAS_DOCKER_IMAGES == 'true'
                }
            }
            parallel {
                stage('🔍 Scan Backend') {
                    when {
                        expression { fileExists('backend/Dockerfile') }
                    }
                    steps {
                        script {
                            echo "🔒 Scan Trivy - Image Backend..."

                            dir('backend') {
                                // Scan de l'image Docker avec Trivy
                                sh """
                                trivy image --format template --template "@html.tpl" -o trivy-backend-report.html ${env.DOCKER_REGISTRY}/${PROJECT_NAME}-backend:${params.IMAGE_TAG}
                                trivy image --severity CRITICAL,HIGH --exit-code 0 ${env.DOCKER_REGISTRY}/${PROJECT_NAME}-backend:${params.IMAGE_TAG} > trivy-backend-results.txt
                                """

                                // Analyse des résultats
                                def trivyOutput = readFile('backend/trivy-backend-results.txt')
                                env.BACKEND_VULNERABILITIES = trivyOutput

                                // Comptage des vulnérabilités
                                def criticalCount = trivyOutput.count('CRITICAL')
                                def highCount = trivyOutput.count('HIGH')

                                echo "📊 Backend - Vulnérabilités: CRITICAL=${criticalCount}, HIGH=${highCount}"

                                if (params.FAIL_ON_VULNERABILITIES && criticalCount > 0) {
                                    error "❌ Vulnérabilités CRITIQUES détectées dans l'image Backend"
                                }
                            }
                        }
                    }
                }

                stage('🔍 Scan Frontend') {
                    when {
                        expression { fileExists('frontend/Dockerfile') }
                    }
                    steps {
                        script {
                            echo "🔒 Scan Trivy - Image Frontend..."

                            dir('frontend') {
                                // Scan de l'image Docker avec Trivy
                                sh """
                                trivy image --format template --template "@html.tpl" -o trivy-frontend-report.html ${env.DOCKER_REGISTRY}/${PROJECT_NAME}-frontend:${params.IMAGE_TAG}
                                trivy image --severity CRITICAL,HIGH --exit-code 0 ${env.DOCKER_REGISTRY}/${PROJECT_NAME}-frontend:${params.IMAGE_TAG} > trivy-frontend-results.txt
                                """

                                // Analyse des résultats
                                def trivyOutput = readFile('frontend/trivy-frontend-results.txt')
                                env.FRONTEND_VULNERABILITIES = trivyOutput

                                // Comptage des vulnérabilités
                                def criticalCount = trivyOutput.count('CRITICAL')
                                def highCount = trivyOutput.count('HIGH')

                                echo "📊 Frontend - Vulnérabilités: CRITICAL=${criticalCount}, HIGH=${highCount}"

                                if (params.FAIL_ON_VULNERABILITIES && criticalCount > 0) {
                                    error "❌ Vulnérabilités CRITIQUES détectées dans l'image Frontend"
                                }
                            }
                        }
                    }
                }

                stage('📋 Scan Fichiers de Configuration') {
                    steps {
                        script {
                            echo "🔒 Scan Trivy - Fichiers de configuration..."

                            // Scan des Dockerfiles
                            if (fileExists('backend/Dockerfile')) {
                                sh """
                                trivy config --severity CRITICAL,HIGH backend/ > trivy-backend-config.txt
                                """
                            }

                            if (fileExists('frontend/Dockerfile')) {
                                sh """
                                trivy config --severity CRITICAL,HIGH frontend/ > trivy-frontend-config.txt
                                """
                            }

                            // Scan des manifests Kubernetes
                            if (fileExists('kubernetes/')) {
                                sh """
                                trivy config --severity CRITICAL,HIGH kubernetes/ > trivy-kubernetes-config.txt
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('☸️ 3. SCAN KUBERNETES MANIFESTS') {
            when {
                expression {
                    params.ACTION in ['security-scan', 'build-deploy'] &&
                    env.HAS_KUBERNETES == 'true'
                }
            }
            steps {
                script {
                    echo "🔒 Scan Trivy - Manifests Kubernetes..."

                    dir('kubernetes') {
                        // Scan de sécurité des manifests Kubernetes
                        sh """
                        trivy k8s --report summary cluster \
                            --format template \
                            --template "@html.tpl" \
                            -o trivy-kubernetes-report.html \
                            --timeout 10m
                        """

                        // Scan des fichiers YAML individuels
                        sh """
                        find . -name "*.yaml" -o -name "*.yml" | xargs -I {} trivy config {} > trivy-k8s-manifests.txt
                        """
                    }

                    // Analyse des résultats Kubernetes
                    if (fileExists('kubernetes/trivy-k8s-manifests.txt')) {
                        def k8sResults = readFile('kubernetes/trivy-k8s-manifests.txt')
                        env.KUBERNETES_VULNERABILITIES = k8sResults

                        def k8sCriticalCount = k8sResults.count('CRITICAL')
                        def k8sHighCount = k8sResults.count('HIGH')

                        echo "📊 Kubernetes - Vulnérabilités: CRITICAL=${k8sCriticalCount}, HIGH=${k8sHighCount}"

                        if (params.FAIL_ON_VULNERABILITIES && k8sCriticalCount > 0) {
                            error "❌ Vulnérabilités CRITIQUES dans les manifests Kubernetes"
                        }
                    }
                }
            }
        }

        stage('🚀 4. DÉPLOIEMENT KUBERNETES') {
            when {
                expression {
                    params.ACTION in ['build-deploy', 'deploy-only'] &&
                    env.HAS_KUBERNETES == 'true'
                }
            }
            steps {
                script {
                    echo "🚀 Déploiement sur Kubernetes..."

                    withCredentials([
                        file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG_FILE')
                    ]) {
                        sh """
                        export KUBECONFIG=${KUBECONFIG_FILE}

                        # Création du namespace si nécessaire
                        kubectl create namespace ${env.KUBERNETES_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

                        # Déploiement des applications
                        if [ -f "kubernetes/backend-deployment.yaml" ]; then
                            kubectl apply -n ${env.KUBERNETES_NAMESPACE} -f kubernetes/backend-deployment.yaml
                        fi

                        if [ -f "kubernetes/frontend-deployment.yaml" ]; then
                            kubectl apply -n ${env.KUBERNETES_NAMESPACE} -f kubernetes/frontend-deployment.yaml
                        fi

                        if [ -f "kubernetes/database-deployment.yaml" ] && [ "${params.DEPLOY_TYPE}" != "basic" ]; then
                            kubectl apply -n ${env.KUBERNETES_NAMESPACE} -f kubernetes/database-deployment.yaml
                        fi

                        # Déploiement des services
                        if [ -f "kubernetes/services.yaml" ]; then
                            kubectl apply -n ${env.KUBERNETES_NAMESPACE} -f kubernetes/services.yaml
                        fi

                        echo "✅ Déploiement Kubernetes terminé"
                        """
                    }
                }
            }
        }

        stage('🧪 5. TESTS ET VÉRIFICATIONS') {
            when {
                expression { params.ACTION in ['build-deploy', 'deploy-only'] }
            }
            steps {
                script {
                    echo "🧪 Tests et vérifications post-déploiement..."

                    withCredentials([
                        file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG_FILE')
                    ]) {
                        sh """
                        export KUBECONFIG=${KUBECONFIG_FILE}

                        # Vérification du statut des pods
                        echo "📊 Statut des pods:"
                        kubectl get pods -n ${env.KUBERNETES_NAMESPACE}

                        # Attente que les pods soient prêts
                        echo "⏳ Attente du déploiement..."
                        kubectl wait --for=condition=ready pod -l app=backend -n ${env.KUBERNETES_NAMESPACE} --timeout=300s
                        kubectl wait --for=condition=ready pod -l app=frontend -n ${env.KUBERNETES_NAMESPACE} --timeout=300s

                        # Tests de santé
                        echo "🔍 Tests de santé..."
                        kubectl get svc -n ${env.KUBERNETES_NAMESPACE}
                        """
                    }
                }
            }
        }

        stage('📋 6. RAPPORT DE SÉCURITÉ') {
            steps {
                script {
                    echo "📋 GÉNÉRATION DU RAPPORT DE SÉCURITÉ"

                    def securityReport = """
                    🔒 RAPPORT DE SÉCURITÉ TRIVY
                    ============================

                    📅 Date: ${new Date().format('yyyy-MM-dd HH:mm:ss')}
                    🎯 Type: ${params.DEPLOY_TYPE}
                    🔧 Action: ${params.ACTION}
                    🐳 Image Tag: ${params.IMAGE_TAG}

                    📊 RÉSULTATS DES SCANS:
                    =====================

                    BACKEND:
                    ${env.BACKEND_VULNERABILITIES ?: 'Aucun scan effectué'}

                    FRONTEND:
                    ${env.FRONTEND_VULNERABILITIES ?: 'Aucun scan effectué'}

                    KUBERNETES:
                    ${env.KUBERNETES_VULNERABILITIES ?: 'Aucun scan effectué'}

                    ⚠️  RECOMMANDATIONS:
                    ===================
                    • Mettre à jour les images de base
                    • Corriger les vulnérabilités CRITICAL/HIGH
                    • Réviser les configurations Kubernetes
                    • Mettre à jour les dépendances

                    ✅ PROCHAINES ÉTAPES:
                    ====================
                    1. Examiner les rapports HTML détaillés
                    2. Corriger les vulnérabilités critiques
                    3. Relancer le scan après corrections
                    4. Déployer en production après validation
                    """

                    writeFile file: 'security-report.txt', text: securityReport

                    // Génération d'un rapport consolidé
                    sh """
                    echo "🔒 RAPPORT CONSOLIDÉ DE SÉCURITÉ" > consolidated-security-report.txt
                    echo "================================" >> consolidated-security-report.txt
                    echo "" >> consolidated-security-report.txt

                    if [ -f "backend/trivy-backend-results.txt" ]; then
                        echo "📋 BACKEND:" >> consolidated-security-report.txt
                        cat backend/trivy-backend-results.txt >> consolidated-security-report.txt
                        echo "" >> consolidated-security-report.txt
                    fi

                    if [ -f "frontend/trivy-frontend-results.txt" ]; then
                        echo "📋 FRONTEND:" >> consolidated-security-report.txt
                        cat frontend/trivy-frontend-results.txt >> consolidated-security-report.txt
                        echo "" >> consolidated-security-report.txt
                    fi

                    if [ -f "kubernetes/trivy-k8s-manifests.txt" ]; then
                        echo "📋 KUBERNETES:" >> consolidated-security-report.txt
                        cat kubernetes/trivy-k8s-manifests.txt >> consolidated-security-report.txt
                    fi
                    """
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'security-report.txt', fingerprint: true
                    archiveArtifacts artifacts: 'consolidated-security-report.txt', fingerprint: true
                    archiveArtifacts artifacts: 'backend/trivy-backend-report.html', fingerprint: true
                    archiveArtifacts artifacts: 'frontend/trivy-frontend-report.html', fingerprint: true
                    archiveArtifacts artifacts: 'kubernetes/trivy-kubernetes-report.html', fingerprint: true
                }
            }
        }
    }

    post {
        always {
            echo "🔧 NETTOYAGE"
            sh '''
            # Nettoyage des images temporaires
            docker image prune -f || true

            # Suppression des fichiers temporaires
            rm -f backend/backend-image.tar || true
            rm -f frontend/frontend-image.tar || true
            rm -f backend/trivy-backend-results.txt || true
            rm -f frontend/trivy-frontend-results.txt || true
            '''
        }

        success {
            script {
                if (params.ACTION != 'security-scan') {
                    echo "🎉 DÉPLOIEMENT RÉUSSI!"
                    echo "🔒 Rapports de sécurité générés"
                    echo "📋 Téléchargez les rapports pour plus d'informations"
                } else {
                    echo "🔒 SCAN DE SÉCURITÉ TERMINÉ"
                    echo "📊 Vulnérabilités analysées avec succès"
                }
            }
        }

        failure {
            echo "❌ ÉCHEC - VULNÉRABILITÉS CRITIQUES OU ERREUR DÉPLOIEMENT"
            echo "💡 Solution: Corriger les vulnérabilités identifiées par Trivy"
        }

        unstable {
            echo "⚠️  BUILD INSTABLE - VULNÉRABILITÉS DÉTECTÉES"
            echo "📋 Consultez le rapport de sécurité pour les détails"
        }
    }
}